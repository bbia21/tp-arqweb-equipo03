# Gateway de la API: api.librecloset.arqweb.test -> microservicios en VM-2
limit_req_zone $binary_remote_addr zone=v2:10m rate=20r/s;
log_format api_json escape=json '{"timestamp":"$time_iso8601","service":"gateway","request_id":"$request_id","remote_addr":"$remote_addr","method":"$request_method","uri":"$request_uri","status":$status,"upstream":"$upstream_addr","duration_s":$request_time}';

upstream calendar_svc { server 192.168.56.11:8001; keepalive 8; }
upstream stats_svc    { server 192.168.56.11:8002; keepalive 8; }
upstream weather_svc  {
    server 192.168.56.11:8003 max_fails=1 fail_timeout=10s;
    server 192.168.56.11:8004 max_fails=1 fail_timeout=10s;
    server 192.168.56.11:8005 max_fails=1 fail_timeout=10s;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name api.librecloset.arqweb.test;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.librecloset.arqweb.test;

    ssl_certificate     /etc/nginx/ssl/librecloset/librecloset.crt;
    ssl_certificate_key /etc/nginx/ssl/librecloset/librecloset.key;
    ssl_protocols TLSv1.3;

    access_log /var/log/nginx/api-access.log api_json;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
    add_header X-Request-ID $request_id always;

    limit_req zone=v2 burst=10 nodelay;
    limit_req_status 429;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
    proxy_send_timeout 5s;

    include /etc/nginx/snippets/api-routes/*.conf;

    location / {
        default_type application/json;
        return 404 '{"error":"not_found","request_id":"$request_id"}';
    }

    error_page 502 503 504 = @down;
    error_page 429 = @ratelimited;
    location @down {
        default_type application/json;
        return 503 '{"error":"service_unavailable","detail":"el servicio no esta disponible","request_id":"$request_id"}';
    }
    location @ratelimited {
        default_type application/json;
        return 429 '{"error":"too_many_requests","request_id":"$request_id"}';
    }
}
