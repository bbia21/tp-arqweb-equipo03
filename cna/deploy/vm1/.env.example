# Copiar a .env (no se versiona) y completar
# Misma contraseña que CDC_PASSWORD en /srv/libre-closet/.env
CDC_PASSWORD=
# Esta noche: admin y la clave de RABBIT_ADMIN_PASSWORD. Después: bridge y RABBIT_BRIDGE_PASSWORD
RABBIT_USER=admin
RABBIT_PASSWORD=
# Esta noche RabbitMQ corre en la misma VM. Mañana: la IP de VM-2
RABBIT_HOST=host.docker.internal
